%% 图 01 软件运行流程（主要代码依据：main.c 的 main()）
flowchart TB
  A(["上电复位"])
  B["板级、传感器、加热、<br/>控制与协议模块初始化"]
  C["加载默认设定温度 40.0 ℃"]
  M["主循环"]
  D{"10 ms 节拍到？"}
  E["依次执行：<br/>温度采集 sensor_read()<br/>温度控制 ctrl_task()<br/>串口通信 uart_task()"]
  A --> B --> C --> M --> D
  D -->|否| M
  D -->|是| E --> M
  class A term
  class B,C,M,E proc
  class D dec
  classDef term fill:#e8ecf0,stroke:#333,stroke-width:1.2px,color:#111
  classDef proc fill:#ffffff,stroke:#333,stroke-width:1px,color:#111
  classDef dec fill:#fcf8ec,stroke:#333,stroke-width:1px,color:#111
