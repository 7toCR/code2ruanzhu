%% 图 03 温度控制（主要代码依据：app/control.c 的 ctrl_task()）
flowchart TB
  A(["ctrl_task()"])
  B{"传感器故障？"}
  D{"温度 ≥ 85.0 ℃？"}
  C["关闭加热输出"]
  E["按偏差做 PI 运算<br/>限幅到 0~100 %"]
  G["heater_set() 输出 PWM 占空比"]
  Z(["返回"])
  A --> B
  B -->|是| C
  B -->|否| D
  D -->|是| C
  D -->|否| E --> G --> Z
  C --> Z
  class A,Z term
  class C,E,G proc
  class B,D dec
  classDef term fill:#e8ecf0,stroke:#333,stroke-width:1.2px,color:#111
  classDef proc fill:#ffffff,stroke:#333,stroke-width:1px,color:#111
  classDef dec fill:#fcf8ec,stroke:#333,stroke-width:1px,color:#111
